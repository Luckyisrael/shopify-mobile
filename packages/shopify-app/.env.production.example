# Production Environment Variables

# Shopify App Configuration
SHOPIFY_API_KEY=your_production_api_key
SHOPIFY_API_SECRET=your_production_api_secret
SHOPIFY_APP_URL=https://your-production-domain.com
SCOPES=read_products,write_checkouts

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Security
JOB_PROCESSING_TOKEN=your_secure_random_token_here
SESSION_SECRET=your_session_secret_here

# External Services
EXPO_ACCESS_TOKEN=your_expo_access_token

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info

# Performance
REDIS_URL=redis://localhost:6379
NODE_ENV=production

# Optional: Custom domain for Shopify
SHOP_CUSTOM_DOMAIN=your-custom-domain.com